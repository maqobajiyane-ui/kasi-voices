# Local development only. Never commit the actual .env or share the curator key.
PORT=3000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=kasi_voices
MEDIA_STORAGE_PATH=./storage
# Generate using: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PUBLISH_ACCESS_KEY=replace-this-with-a-unique-random-secret-at-least-32-characters
NODE_ENV=development
